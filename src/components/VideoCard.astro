---
// Instagram MAIN FEED layout (not the earlier Reels-style overlay): a post
// header (avatar/handle/location), the video as its own letterboxed block,
// an action/meta row, then a caption block — all on
// plain black, never metadata burned over the footage — except the like
// button/count, which overlays the video on mobile only (Instagram
// Reels-style, confirmed as a deliberate exception; desktop keeps it as its
// own row below the video, unchanged from the rest of this principle). See
// docs/design-spec.md §9 ("Why the feed card is changing shape, not just
// colour") for the rationale.
import type { VideoEntry } from "../lib/schema";
import { MEDIA_BASE } from "../config";

export interface Props {
  video: VideoEntry;
  index: number;
}

const { video, index } = Astro.props;

const videoSrc = `${MEDIA_BASE}${video.media.video}`;
const thumbSrc = `${MEDIA_BASE}${video.media.thumbnail}`;
const isFirst = index === 0;

const eventDate = new Date(video.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const archivedDate = new Date(video.archivedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

// Deterministic monogram avatar: no avatar images exist in the data, and CSP
// forbids fetching remote images anyway. First letter of the uploader handle
// on a --color-surface circle with a --color-border ring.
const avatarInitial = video.source.uploader.replace(/^@/, "").trim().charAt(0).toUpperCase() || "?";

---

<article
  class="feed-card"
  data-video-id={video.id}
  data-video-src={videoSrc}
  data-footage-origin={video.footageOrigin}
  tabindex="0"
  role="group"
  aria-roledescription="slide"
  aria-label={`${video.title}. Press Enter or Space to play or pause, up or down arrow to move between videos.`}
>
  <div class="card-frame">
    <header class="card-header">
      <div class="avatar" aria-hidden="true">{avatarInitial}</div>
      <div class="header-text">
        <span class="handle">{video.source.uploader}</span>
        {video.location && <span class="location">{video.location}</span>}
      </div>
    </header>

    <div class="video-wrap">
      {/* For footage whose native aspect ratio doesn't match this card
          (mostly landscape clips — most of the catalog is native 9:16 and
          barely shows this), object-fit: contain below leaves a tall band
          of flat --color-letterbox above/below the frame, and the mute/like/
          progress controls anchored to the wrap's true bottom edge end up
          floating in it, disconnected from the visible footage. This layer
          extends the same thumbnail behind the frame, blurred and darkened,
          so that band still reads as "one continuous black field" (per
          docs/design-spec.md's letterbox rationale) instead of dead space —
          the actual footage above it is never cropped or altered. */}
      <div class="video-backdrop" style={`--backdrop-image: url(${thumbSrc})`} aria-hidden="true"></div>

      <video
        playsinline
        muted
        loop
        preload={isFirst ? "metadata" : "none"}
        poster={thumbSrc}
        fetchpriority={isFirst ? "high" : "auto"}
        width={video.media.width}
        height={video.media.height}
        class="card-video"
      >
        <track kind="captions" />
      </video>

      <div class="play-glyph" aria-hidden="true" data-icon="play">
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"></path></svg>
      </div>

      {/* Always the filled weight — the burst only ever plays on a
          confirmed like, same as the button's own filled state below. */}
      <div class="like-burst" aria-hidden="true">
        <svg class="icon-fist" viewBox="0 0 256 256" fill="currentColor">
          <path d="M232,120v8A104,104,0,0,1,127.63,232c-54-.19-98-42.06-103.12-94.78a4,4,0,0,1,5.56-4A35.94,35.94,0,0,0,72,122.59a35.92,35.92,0,0,0,53.94,2.33,40.36,40.36,0,0,0,12.87,13A47.94,47.94,0,0,0,120,176a8,8,0,0,0,8.67,8,8.21,8.21,0,0,0,7.33-8.26A32,32,0,0,1,168,144a8,8,0,0,0,8-8.53,8.18,8.18,0,0,0-8.25-7.47H160a24,24,0,0,1-24-24V88h64A32,32,0,0,1,232,120ZM44.73,120C55.57,119.6,64,110.37,64,99.52v-23C64,65.63,55.57,56.4,44.73,56A20,20,0,0,0,24,76v24A20,20,0,0,0,44.73,120Zm56,0c10.84-.39,19.27-9.62,19.27-20.47v-47c0-10.85-8.43-20.08-19.27-20.47A20,20,0,0,0,80,52v48A20,20,0,0,0,100.73,120ZM176,52a20,20,0,0,0-20.73-20C144.43,32.4,136,41.63,136,52.48V72h36a4,4,0,0,0,4-4Z"/>
        </svg>
      </div>

      <div class="like-slot-overlay"></div>

      <button
        type="button"
        class="mute-btn"
        aria-label="Mute video"
        aria-pressed="true"
        data-muted="true"
      >
        <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z"></path>
          <line x1="16" y1="9" x2="21" y2="15"></line>
          <line x1="21" y1="9" x2="16" y2="15"></line>
        </svg>
        <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z"></path>
          <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
          <path d="M18 6a9 9 0 0 1 0 12"></path>
        </svg>
      </button>

      {/* Hit area is padded well beyond the 3px visible bar (see
          .progress-hit / .progress-track below) because a 3px target is
          unhittable on touch. role="slider" + the aria-value* triad make
          this a real scrubber for AT, not just a decorative meter; feed.ts
          wires up pointer + keyboard handling.

          Note the JSX-expression comment form: a plain HTML comment here
          would be emitted into the markup once per card, shipping this
          paragraph to every visitor five times over. Astro strips this
          form at build instead. */}
      <div
        class="progress-hit"
        role="slider"
        tabindex="0"
        aria-label="Seek video"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="progress-track">
          <div class="progress-fill"></div>
        </div>
      </div>
    </div>

    <div class="like-slot-row">
      <button
        type="button"
        class="like-btn"
        data-liked="false"
        data-hydrated="false"
        aria-pressed="false"
        aria-label="Like this video"
      >
        {/* "hand-fist" from Phosphor Icons (phosphoricons.com), MIT licensed
            — light weight (outline) + fill weight, toggled by data-liked,
            same pattern as .play-glyph's icon-play/icon-pause pair above.
            Not a single shape with opacity/scale: Instagram's own like icon
            swaps hollow-outline for solid-filled on activation, and an
            outline *derived* from a filled shape (stroke, or an SVG erode+
            composite filter) reads as messy/uneven at this button's small
            render size — confirmed by rendering both before choosing this. */}
        <svg class="icon-fist icon-fist-outline" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M200,82H182V64a30,30,0,0,0-54-18A30,30,0,0,0,74,64v0A30,30,0,0,0,26,88v40a102,102,0,0,0,204,0V112A30,30,0,0,0,200,82ZM152,46a18,18,0,0,1,18,18V82H136a14.71,14.71,0,0,0-2,.16V64A18,18,0,0,1,152,46ZM86,64a18,18,0,0,1,36,0v40a18,18,0,0,1-36,0ZM38,88a18,18,0,0,1,36,0v16a18,18,0,0,1-36,0Zm180,40a90,90,0,0,1-180,0h0a30,30,0,0,0,42-6,30,30,0,0,0,45.12,3.3A30.18,30.18,0,0,0,140,139.51,45.92,45.92,0,0,0,122,176a6,6,0,0,0,12,0,34,34,0,0,1,34-34,6,6,0,0,0,0-12H152a18,18,0,0,1-18-18V96a2,2,0,0,1,2-2h64a18,18,0,0,1,18,18Z"/>
        </svg>
        <svg class="icon-fist icon-fist-filled" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M232,120v8A104,104,0,0,1,127.63,232c-54-.19-98-42.06-103.12-94.78a4,4,0,0,1,5.56-4A35.94,35.94,0,0,0,72,122.59a35.92,35.92,0,0,0,53.94,2.33,40.36,40.36,0,0,0,12.87,13A47.94,47.94,0,0,0,120,176a8,8,0,0,0,8.67,8,8.21,8.21,0,0,0,7.33-8.26A32,32,0,0,1,168,144a8,8,0,0,0,8-8.53,8.18,8.18,0,0,0-8.25-7.47H160a24,24,0,0,1-24-24V88h64A32,32,0,0,1,232,120ZM44.73,120C55.57,119.6,64,110.37,64,99.52v-23C64,65.63,55.57,56.4,44.73,56A20,20,0,0,0,24,76v24A20,20,0,0,0,44.73,120Zm56,0c10.84-.39,19.27-9.62,19.27-20.47v-47c0-10.85-8.43-20.08-19.27-20.47A20,20,0,0,0,80,52v48A20,20,0,0,0,100.73,120ZM176,52a20,20,0,0,0-20.73-20C144.43,32.4,136,41.63,136,52.48V72h36a4,4,0,0,0,4-4Z"/>
        </svg>
        <span class="like-count"></span>
      </button>
    </div>

    <div class="meta-row">
      <span class="meta-left">
        {
          video.source.url ? (
            // The platform name itself is the CTA to the ORIGINAL post — this
            // is the credibility anchor, so it points off-site rather than at
            // our own /video/[id]/ page. stopPropagation in feed.ts keeps the
            // tap from also toggling play/pause on the card underneath.
            <a
              href={video.source.url}
              class="source-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View original post on ${video.source.platform} (opens in a new tab)`}
            >
              View on {video.source.platform} <span aria-hidden="true">&#8599;</span>
            </a>
          ) : (
            <span>{video.source.platform}</span>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <time datetime={video.date}>{eventDate}</time>
      </span>
    </div>

    <div class="caption-block">
      <p class="caption line-clamp-2">
        <span class="caption-handle">{video.source.uploader}</span> {video.description}
      </p>
      <button type="button" class="more-link" aria-expanded="false" hidden>more</button>
      <time class="archived-date" datetime={video.archivedAt}>Archived {archivedDate}</time>
    </div>
  </div>
</article>

<style>
  .feed-card {
    /* Sized to fill its scroll container (#feed), which is itself sized to
       100svh/100dvh minus the app header by Base.astro's fullBleed layout —
       NOT to the raw device viewport. Using 100dvh directly here would make
       each card taller than the visible scrollport and break snap-locking.
       On mobile the app shell's bottom tab bar is `position: fixed` and
       floats translucently OVER full-bleed content (see Base.astro), so the
       card reserves --app-nav-h at its own bottom edge — otherwise the
       caption block could sit underneath the floating nav, unreadable. On
       >=768px the nav is an in-flow top bar and no longer overlaps. */
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding-bottom: calc(var(--app-nav-h) + env(safe-area-inset-bottom, 0px));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    background: var(--color-bg);
    isolation: isolate;
  }

  @media (min-width: 768px) {
    .feed-card {
      padding-bottom: 0;
    }
  }

  .feed-card:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
  }

  .card-frame {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .card-frame {
      max-width: 28rem;
    }
  }

  /* --- Post header: avatar, handle + location --- */

  .card-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
  }

  .avatar {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .header-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .handle {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location {
    font-size: 0.75rem;
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- Video: the flexible element that absorbs leftover height --- */

  .video-wrap {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    background: var(--color-letterbox);
  }

  /* Scaled up so the blur radius never pulls in its own transparent edge,
     and z-index: 0 keeps it strictly behind the real frame — this is
     decorative fill for the letterbox band, never the content itself.
     Dark enough that it reads as depth, not a distinct lighter smear. */
  .video-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--backdrop-image);
    background-size: cover;
    background-position: center;
    transform: scale(1.15);
    filter: blur(28px) brightness(0.25);
    pointer-events: none;
  }

  /* Sits just above .video-backdrop (still below .card-video, which
     occludes it wherever real footage exists) so the immediate strip
     behind the mute button and progress bar — visible only in the
     letterbox band — is solid black instead of the blurred backdrop.
     The bar needs a clean, unbroken black field directly under it; a
     visible seam between "blurred content" and "flat black" right where
     it sits is what read as a stray artifact. Anything further up in a
     tall letterbox gap still gets the softer blurred fill. */
  .video-wrap::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    height: 3.4rem;
    background: linear-gradient(to top, #000 65%, transparent 100%);
    pointer-events: none;
  }

  .card-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  .play-glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
  }

  .play-glyph.show {
    animation: glyph-fade 650ms ease forwards;
  }

  .play-glyph svg {
    width: 4.5rem;
    height: 4.5rem;
    color: #fff;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.5));
    display: none;
  }

  .play-glyph[data-icon="play"] .icon-play {
    display: block;
  }

  .play-glyph[data-icon="pause"] .icon-pause {
    display: block;
  }

  @keyframes glyph-fade {
    0% {
      opacity: 0;
      transform: scale(0.8);
    }
    15% {
      opacity: 0.9;
      transform: scale(1);
    }
    75% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  /* Small translucent pill anchored to the video's own bottom-right corner
     — no longer needs to dodge the floating bottom nav itself, since that
     reserve now lives on .feed-card's padding-bottom, above. */
  .mute-btn {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 25;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    cursor: pointer;
    transition: opacity 300ms ease;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .mute-btn {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .mute-btn.is-idle {
    opacity: 0;
  }

  .mute-btn svg {
    width: 1.1rem;
    height: 1.1rem;
    position: absolute;
    transition: opacity 200ms ease;
  }

  .mute-btn[data-muted="true"] .icon-unmuted {
    opacity: 0;
  }

  .mute-btn[data-muted="false"] .icon-muted {
    opacity: 0;
  }

  /* Empty positioning slot for the like button on mobile — feed.ts moves
     the real .like-btn node in here at <768px so it overlays the video's
     bottom-right corner, Reels-style. Sits above .mute-btn (z-index 25)
     with a gap that clears its 2.25rem height. On >=768px this stays
     empty; the button lives in .like-slot-row below instead (own row,
     not burned over the footage — see the file's top comment). */
  .like-slot-overlay {
    position: absolute;
    right: 0.6rem;
    bottom: 3.4rem;
    z-index: 26;
  }

  /* The visible bar stays a thin 3px (Instagram-style), but the tappable
     area is padded out to >=20px tall so it's actually hittable on a phone
     — a 3px target fails any reasonable touch-target guideline. The padded
     wrapper sits at the same bottom edge as the old bar; the visible track
     is centered inside it via flex. touch-action: none stops a horizontal
     drag on the bar from being interpreted as page/feed scroll, which would
     otherwise fight the vertical scroll-snap between cards. */
  .progress-hit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20px;
    z-index: 22;
    display: flex;
    align-items: center;
    padding: 0 0.15rem;
    box-sizing: border-box;
    touch-action: none;
    cursor: pointer;
  }

  .progress-hit:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }

  .progress-track {
    position: relative;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    transition: height 120ms ease;
  }

  /* Grown slightly while actively scrubbing so the user gets visual
     confirmation the drag registered — set by feed.ts via a data attribute
     on the hit wrapper rather than a :active pseudo-class, since dragging
     can continue after the pointer leaves the element (pointer capture). */
  .progress-hit[data-scrubbing="true"] .progress-track {
    height: 5px;
  }

  .progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    height: 100%;
    width: 0%;
    background: #fff;
    border-radius: inherit;
  }

  /* --- Action/meta row: platform · date, source link --- */

  /* justify-content is a plain flex-start now — .like-btn used to live in
     here too (hence the old space-between), but it's since moved to its
     own .like-slot-row below so this row only ever holds .meta-left. */
  .meta-row {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The clickable CTA IS the platform name now (was a separate "Details"
     link to our own page) — it points off-site at the original post, so it
     needs a visible "leaves the site" affordance (the arrow glyph) even at
     this row's small 0.75rem size. */
  .source-link {
    flex: 0 0 auto;
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }

  .source-link:hover {
    text-decoration: underline;
  }

  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 24px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-muted);
  }

  .like-btn .icon-fist {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-text);
    transition: transform 150ms ease;
  }

  /* Outline (unliked) shown by default; filled swaps in on data-liked, same
     display-toggle pattern as .play-glyph's icon-play/icon-pause pair. */
  .like-btn .icon-fist-filled {
    display: none;
  }

  .like-btn[data-liked="true"] .icon-fist-outline {
    display: none;
  }

  .like-btn[data-liked="true"] .icon-fist-filled {
    display: block;
  }

  .like-btn[data-liked="true"] .icon-fist {
    transform: scale(1.08);
  }

  .like-count {
    font-size: 0.75rem;
    min-width: 0.6em;
  }

  .like-btn[data-hydrated="false"] .like-count {
    visibility: hidden;
  }

  /* .like-btn's one and only server-rendered home: its own row below the
     video, in normal flow, never overlapping the footage — the desktop
     default and the no-JS fallback. feed.ts's positionLikeButton() moves
     the same button node into .like-slot-overlay above instead at <768px;
     it is never duplicated between the two slots. */
  .like-slot-row {
    flex: 0 0 auto;
    display: flex;
    justify-content: flex-end;
    padding: 0.4rem 0.75rem;
  }

  /* Once JS has relocated .like-btn out to the mobile overlay slot, this
     row is left empty — collapse it to zero height so it doesn't leave a
     blank gap between the video and .meta-row. */
  .like-slot-row:empty {
    padding: 0;
  }

  /* Mobile overlay state (added by feed.ts alongside the move into
     .like-slot-overlay): bigger, and always carries a drop-shadow since it
     sits over arbitrary video content — a plain white outline can vanish
     against a bright frame without it. */
  .like-btn.is-overlay {
    flex-direction: column;
    gap: 0.15rem;
  }

  .like-btn.is-overlay .icon-fist {
    width: 2.15rem;
    height: 2.15rem;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.6));
  }

